{
  "name": "stamping-monitor",
  "version": "1.0.0",
  "description": "Sistem monitoring operasional & produksi 30 mesin stamping (RFID, kamera, PLC) — rangka kursi bus",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
